# Pooled Lakebase Postgres connection for application traffic.
DATABASE_URL=postgresql://user:password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=verify-full

# Direct connection used only by Drizzle migrations.
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=verify-full

# Neon Auth endpoint and an application-owned random cookie signing secret.
NEON_AUTH_BASE_URL=https://ep-example.neonauth.us-east-2.aws.neon.tech/neondb/auth
NEON_AUTH_COOKIE_SECRET=replace-with-at-least-32-random-characters

# Match a Vapi Custom Credential configured as Authorization: Bearer <token>.
VAPI_SERVER_TOKEN=replace-with-at-least-32-random-characters

HOST=0.0.0.0
PORT=3001
LOG_LEVEL=info
